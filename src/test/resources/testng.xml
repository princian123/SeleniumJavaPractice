<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium UI Suite" parallel="methods" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.example.framework.listeners.ExtentReportListener"/>
    </listeners>
    <test name="Login Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.example.tests.LoginTest"/>
        </classes>
    </test>
</suite>